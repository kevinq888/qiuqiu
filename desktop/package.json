{
  "name": "qiuqiumusic-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "秋秋音乐本地桌面播放器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "generate:icons": "node generate-icons.js",
    "build:mac": "node scripts/build-desktop.cjs mac",
    "build:win": "node scripts/build-desktop.cjs win",
    "build:all": "node scripts/build-desktop.cjs all",
    "test:local": "node scripts/test-local.cjs"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.qiuqiumusic.desktop",
    "productName": "秋秋音乐",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "icon.png",
      "app-icon.png",
      "tray-icon.png"
    ],
    "icon": "app-icon.png",
    "mac": {
      "icon": "app-icon.png",
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "..",
        "to": "backend",
        "filter": [
          "server.js",
          "package.json",
          "README.md",
          "src/**/*.js",
          "public/**/*",
          "data/seed.json"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
