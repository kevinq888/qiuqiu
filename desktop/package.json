{
  "name": "qiuqiumusic-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "秋秋音乐桌面迷你播放器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.qiuqiumusic.desktop",
    "productName": "秋秋音乐",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "icon.png"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
